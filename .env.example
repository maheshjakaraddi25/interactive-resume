# ─── AI API Keys ──────────────────────────────────────────────────────────────
# Get your Anthropic key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get your OpenAI key: https://platform.openai.com/api-keys
# Used for: GPT-4o chat responses + text-embedding-3-small (for RAG)
OPENAI_API_KEY=your_openai_api_key_here

# ─── Server Config ────────────────────────────────────────────────────────────
PORT=5000

# URL of the React client (for CORS). Default for local dev:
CLIENT_ORIGIN=http://localhost:3000
